<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FF0E1B30</color>
    <color name="focus">#FF3CBCB9</color>
    <color name="icon_bg">#FF102038</color>

    <style name="Theme.Fokkus" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/focus</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Fokkus.Block">
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
